{
  "manifest_version": 3,
  "name": "Asistente de Clases",
  "version": "1.2",
  "description": "Graba el audio de la pestaña activa, captura pantallas y procesa clases.",
  "permissions": [
    "activeTab",
    "tabCapture",
    "offscreen",
    "storage",
    "alarms",
    "downloads",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
